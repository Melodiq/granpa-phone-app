    <string name="hint_idle">点击屏幕发出命令</string>
    <string name="hint_sleep">呼叫我请说「Алёша」</string>
    <string name="sleep_status">休息中</string>
    <string name="sleep_hint">说「Алёша」或点击屏幕呼叫我</string>
